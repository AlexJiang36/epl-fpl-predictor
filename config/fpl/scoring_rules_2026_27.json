    },
    {
      "title": "What's happening with defensive contribution points in 2026/27 Fantasy?",
      "publisher": "Premier League",
      "purpose": "Confirms defensive-contribution points remain: 10 CBIT for defenders and 12 CBIRT for midfielders/forwards, worth two points and capped at two per match.",
      "url": "https://www.premierleague.com/en/news/4361991/whats-happening-with-defensive-contribution-points-in-202627-fantasy"
    },
    {
      "title": "FPL basics explained: Scoring points",
      "publisher": "Premier League",
      "purpose": "Core awarded FPL points table and bonus allocation.",
      "url": "https://www.premierleague.com/en/news/2174909"
    }
  ],
