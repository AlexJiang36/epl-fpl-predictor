          "2025_26": "1_bps_per_2_cbi",
          "2026_27": "1_bps_per_3_cbi"
        },
        {
          "metric": "goalkeeper_any_save",
          "2025_26": "location_specific_base",
          "2026_27": "2_bps_per_any_save"
        },
        {
          "metric": "goalkeeper_inside_box_save",
          "2025_26": "3_bps_total",
          "2026_27": "2_base_plus_1_inside_box"
        },
