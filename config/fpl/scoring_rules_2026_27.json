        "GKP": 10,
        "DEF": 6,
        "MID": 5,
        "FWD": 4
      }
    },
    "assists": {
      "points": 3,
      "definition_version": "fpl_2026_27_assist_points_policy_v1",
      "notes": [
        "The awarded-assist event remains an upstream event-classification concern.",
        "This registry explicitly versions the 2026/27 conversion of each awarded assist into three points.",
        "No unverified historical assist definition is inherited silently."
      ]
    },
    "clean_sheets": {
      "minimum_minutes": 60,
      "minutes_basis": "completed_minutes_excluding_stoppage_time",
      "concession_scope": "goals_conceded_while_player_on_pitch",
      "substituted_before_later_concession_keeps_points": true,
      "points_by_position": {
        "GKP": 4,
        "DEF": 4,
        "MID": 1,
        "FWD": 0
      }
    },
    "saves": {
      "per_saves": 3,
      "points": 1,
      "uncapped": true,
      "eligibility": "player_acting_as_goalkeeper"
    },
    "penalty_saves": {
      "points": 5,
      "eligibility": "player_acting_as_goalkeeper"
    },
    "cards": {
      "yellow_points": -1,
      "red_points": -3,
      "red_points_include_yellow_deductions": true,
      "red_card_player_continues_to_be_charged_for_applicable_goals_conceded": true
    },
    "own_goals": {
      "points": -2
    },
    "penalty_misses": {
      "points": -2
    },
    "goals_conceded": {
      "eligible_positions": [
        "GKP",
        "DEF"
      ],
      "per_goals": 2,
      "points": -1,
      "input_semantics": "goals_conceded_for_scoring_after_applying_on_pitch_and_red_card_rules"
    },
    "bonus": {
      "allowed_player_points": [
        0,
        1,
        2,
        3
      ],
      "rank_points": {
        "1": 3,
        "2": 2,
        "3": 1
      },
      "tie_policy": [
        "Tie for first: tied first-place players receive 3 each; next eligible rank receives 1.",
        "Tie for second: first receives 3; tied second-place players receive 2 each.",
        "Tie for third: first receives 3; second receives 2; tied third-place players receive 1 each."
      ],
      "scope": "awarded_fpl_bonus_points_only",
      "full_bps_event_calculator_included": false,
      "bps_policy_version": "fpl_2026_27_bps_v1",
      "bps_change_status": "recorded_as_model_limitation_until_event_level_bps_model_exists",
      "target_season_changes_recorded": true
    },
