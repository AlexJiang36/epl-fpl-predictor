      "minutes_basis": "completed_minutes_excluding_stoppage_time",
      "bands": [
        {
          "min_minutes": 1,
          "max_minutes": 59,
          "points": 1
        },
        {
          "min_minutes": 60,
          "max_minutes": null,
          "points": 2
        }
      ]
    },
