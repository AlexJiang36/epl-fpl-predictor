{
  "schema_version": "fpl_chip_rules_v1",
  "competition": "FPL",
  "effective_season": "2025_26",
  "rules_version": "fpl_2025_26_chips_v1",
  "status": "verified_target_season_registry",
  "source_notes": [
    "Official 2025/26 FPL guidance provides two sets of Wildcard, Free Hit, Triple Captain, and Bench Boost chips: one set for the first half and one set for the second half.",
    "The first-half set expires after the Gameweek 19 deadline and cannot be carried into Gameweek 20; the second-half set becomes available from Gameweek 20 through the end of the season.",
    "Only one chip may be active in a Gameweek.",
    "Wildcard and Free Hit cannot be played in Gameweek 1. Free Hit cannot be played in consecutive Gameweeks.",
    "Wildcard and Free Hit are confirmed with transfers and cannot be cancelled after confirmation. Triple Captain and Bench Boost may be cancelled before the Gameweek deadline.",
    "Wildcard transfers are unlimited and permanent for the active Gameweek. Free Hit transfers are unlimited for one Gameweek and the prior squad and bank are restored at the next deadline, with intervening player price changes reflected.",
    "Wildcard and Free Hit preserve previously banked free transfers and remove transfer-hit deductions for the active Gameweek.",
    "There is no Assistant Manager chip in 2025/26."
  ],
  "season": {
    "first_gameweek": 1,
    "last_gameweek": 38,
    "split_after_gameweek": 19,
    "second_half_starts_gameweek": 20
  },
  "global_rules": {
    "maximum_active_chips_per_gameweek": 1,
    "unused_first_half_inventory_carries_to_second_half": false,
    "refresh_inventory_at_second_half": true,
    "unsupported_chip_ids": [
      "assistant_manager"
    ]
  },
  "inventory_windows": [
    {
      "window_id": "first_half",
      "available_from_gameweek": 1,
      "available_through_gameweek": 19,
      "expires_after_gameweek": 19,
      "reset_behavior": "expire_unused"
    },
    {
      "window_id": "second_half",
      "available_from_gameweek": 20,
      "available_through_gameweek": 38,
      "expires_after_gameweek": 38,
      "reset_behavior": "end_of_season"
    }
  ],
