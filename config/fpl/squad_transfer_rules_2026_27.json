  "schema_version": "fpl_squad_transfer_rules_v1",
  "competition": "FPL",
  "effective_season": "2026_27",
  "rules_version": "fpl_2026_27_squad_transfer_v1",
  "status": "verified_target_season_registry",
  "source_notes": [
    "Official FPL squad-selection guidance: £100.0m budget, 15 players, position quotas 2/5/5/3, and maximum three players per club.",
    "Official 2026/27 guidance: one free transfer per Gameweek, up to five may be stored, and additional transfers cost four points.",
    "Official 2026/27 guidance explicitly states that the 2025/26 AFCON free-transfer top-up does not recur because AFCON is not taking place during the 2026/27 campaign.",
    "Official FPL chip guidance: Wildcard and Free Hit provide unlimited transfers for the active Gameweek while preserving previously banked free transfers; no normal weekly accrual is added through that chip transition.",
    "Live selling-price and bank calculations remain external inputs; this registry validates integer price units and caller-supplied affordability limits."
  ],
  "positions": [
    "GKP",
    "DEF",
    "MID",
    "FWD"
  ],
  "units": {
    "price_unit": "tenths_of_million_gbp",
    "one_price_unit_gbp_millions": 0.1,
    "initial_budget_units": 1000
  },
  "squad": {
    "size": 15,
    "position_quotas": {
      "GKP": 2,
      "DEF": 5,
      "MID": 5,
      "FWD": 3
    },
    "max_players_per_club": 3,
    "duplicate_players_allowed": false
  },
  "lineup": {
    "starting_size": 11,
    "bench_size": 4,
    "position_bounds": {
      "GKP": {
        "min": 1,
        "max": 1
      },
      "DEF": {
        "min": 3,
        "max": 5
      },
      "MID": {
        "min": 2,
        "max": 5
      },
      "FWD": {
        "min": 1,
        "max": 3
      }
    },
    "bench": {
      "goalkeepers": 1,
      "outfield_players": 3
    },
    "captain_required": true,
    "vice_captain_required": true,
    "captain_and_vice_must_differ": true
  },
  "transfers": {
    "pre_season": {
      "unlimited_free_transfers": true,
      "hit_cost_points": 0
    },
    "weekly": {
      "free_transfers_accrued_per_gameweek": 1,
      "maximum_stored_free_transfers": 5,
      "hit_cost_points_per_additional_transfer": 4,
      "incoming_count_must_equal_outgoing_count": true
    },
    "chip_behavior": {
      "wildcard": {
        "unlimited_free_transfers": true,
        "preserve_saved_free_transfers": true,
        "weekly_accrual_after_chip": 0,
        "remove_transfer_hits": true,
        "temporary_squad": false
      },
      "free_hit": {
        "unlimited_free_transfers": true,
        "preserve_saved_free_transfers": true,
        "weekly_accrual_after_chip": 0,
        "remove_transfer_hits": true,
        "temporary_squad": true
      }
    },
    "special_events": []
  },
